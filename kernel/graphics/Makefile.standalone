CXX = g++
CXXFLAGS = -m32 -nostdlib -nostdinc -fno-builtin -fno-stack-protector -nostartfiles -nodefaultlibs -Wall -Wextra -Werror -c -I/usr/include -I/usr/local/include -I..
LDFLAGS = -m32 -T linker.ld -nostdlib

SRCS = vga.cc test_vga.cc
OBJS = $(SRCS:.cc=.o)
TARGET = vga_test_standalone.bin

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^

%.o: %.cc
	$(CXX) $(CXXFLAGS) -o $@ $<

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all clean 