#!/bin/bash

ORIGINAL_DIR="$(pwd)"
THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# cd into /shell/tests
cd $THIS_DIR
cd ../tests

# count how many .ok files
COUNT=$(ls -1 *.ok 2>/dev/null | wc -l)
TESTDIR_NAME="t${COUNT}.dir"

echo "creating ${TESTDIR_NAME} ${TESTDIR_NAME}/sbin t${COUNT}.ok"

mkdir -p "$TESTDIR_NAME/sbin"
mkdir -p "$TESTDIR_NAME/bin"
touch "t${COUNT}.ok"

# copy the test environment
# everything here is hard linked
cp -l ./env/sbin/* "$TESTDIR_NAME/sbin/"

# copy from src
# ignore the error lol
cp -l ../src/* 2>/dev/null "$TESTDIR_NAME/sbin/"
cp -l ../src/bin/* "$TESTDIR_NAME/bin"

# make input file (not hardlinked)
mkdir -p "$TESTDIR_NAME/user"
cd "$TESTDIR_NAME/user"
echo exit > input

echo "*** fill out input.txt and .ok file"
echo "*** then cook t##"

cd $ORIGINAL_DIR