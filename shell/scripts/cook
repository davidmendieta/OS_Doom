#!/bin/bash

export TESTS_DIR=shell/tests
ORIGINAL_DIR="$(pwd)"
THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# cd into /shell/tests
cd $THIS_DIR
cd ../tests

# build shell
echo "compiling $1"
cd "./env"
make clean
make -s

# build /bin
cd "../$1.dir/bin"
make clean
make -s

cd $ORIGINAL_DIR

make -s clean $1.test